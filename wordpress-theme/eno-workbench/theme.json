    "typography": { "fluid": true }
  },
  "styles": {
    "color": { "background": "#070b0f", "text": "#dce3eb" },
    "typography": { "fontFamily": "'Noto Sans SC', system-ui, sans-serif", "lineHeight": "1.8" }
  }
